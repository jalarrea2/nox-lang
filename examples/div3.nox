# Divisibility-by-3 DFA — recognizes binary numbers divisible by 3.
#
# Three states (labels) = the running remainder mod 3 as bits are read
# most-significant-first: on bit b, next = (2*remainder + b) % 3.
# Reads '0'/'1' until EOF (other characters are ignored), then prints
# 'Y' if the value is divisible by 3, 'N' otherwise. Empty input -> 'Y' (0).
#
#   s0 --'0'--> s0   s0 --'1'--> s1
#   s1 --'0'--> s2   s1 --'1'--> s0
#   s2 --'0'--> s1   s2 --'1'--> s2

r7 = -1         # EOF
r8 = 48         # '0'
r9 = 49         # '1'

s0:                 # remainder 0 (accepting)
read r0
r1 = r0 == r7
if r1 != 0 goto accept
r2 = r0 == r8
if r2 != 0 goto s0
r3 = r0 == r9
if r3 != 0 goto s1
goto s0

s1:                 # remainder 1
read r0
r1 = r0 == r7
if r1 != 0 goto reject
r2 = r0 == r8
if r2 != 0 goto s2
r3 = r0 == r9
if r3 != 0 goto s0
goto s1

s2:                 # remainder 2
read r0
r1 = r0 == r7
if r1 != 0 goto reject
r2 = r0 == r8
if r2 != 0 goto s1
r3 = r0 == r9
if r3 != 0 goto s2
goto s2

accept:
r4 = 89             # 'Y'
putc r4
goto fin
reject:
r4 = 78             # 'N'
putc r4

fin:
r5 = 10             # '\n'
putc r5
halt
