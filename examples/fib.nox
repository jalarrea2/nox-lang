# Imprime los primeros 15 números de Fibonacci separados por espacio.
# Ejercita: IMM, binarias, comparación, salto condicional, MOV, I/O.

r0 = 0          # a
r1 = 1          # b
r2 = 0          # contador
r3 = 15         # límite

loop:
r4 = r2 < r3
if r4 == 0 goto end
print r0
r5 = 32         # ' '
putc r5
r6 = r0 + r1    # siguiente
r0 = r1
r1 = r6
r7 = 1
r2 = r2 + r7
goto loop

end:
r8 = 10         # '\n'
putc r8
halt
